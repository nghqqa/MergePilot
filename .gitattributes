# 强制 LF 行尾:防 Windows 上 git autocrlf 把脚本/配置改成 CRLF
# (CRLF 会让 bash 报 "$'do\r': syntax error",见 Step 2 踩坑)。
*.sh   text eol=lf
*.py   text eol=lf
*.sql  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# 证据目录按原始字节 SHA256 锁定，禁止 git 做任何行尾/编码转换，
# 否则 checkout 后哈希漂移，selftest 的完整性断言会失败。
evidence/** -text
