# MergePilot Demo Platform — 环境变量配置模板
# 复制本文件为 .env 并按需修改后生效
# 所有变量均有安全的默认值——不设置也能正常启动

# ── 演示平台服务 ──────────────────────────────
PORT=4173
HOST=127.0.0.1

# ── 证据根目录 ──────────────────────────────────
# 平台按相对路径查找回放证据子集（evidence/）
# DEMO_EVIDENCE_ROOT=./evidence

# ── Live 模式数据源（可选）────────────────────
# 如果演示平台与 AgentTeams runtime 在同一网络，取消注释以启用 Live 探针
# DEMO_LIVE_MATRIX_URL=http://127.0.0.1:6167/_matrix/client/versions
# DEMO_LIVE_MINIO_URL=http://127.0.0.1:9000/minio/health/live
# DEMO_LIVE_CONTROLLER_URL=
# DEMO_LIVE_ELEMENT_URL=http://127.0.0.1:18088/config.json

# ── PolarDB（可选——当前 NOT CONNECTED）────────
# 8 项门槛全部满足后取消注释并填入真实值，系统自动切换 LIVE
# POLARDB_ENDPOINT=
# POLARDB_DATABASE=
# POLARDB_READONLY_USER=
# POLARDB_SECRET_REF=
# POLARDB_ALLOWLIST_CONFIRMED=
# POLARDB_BRANCH_API=
# POLARDB_MODE=auto

# ── AgentLoop 遥测（可选——relay 已单独运行）────
# relay 在 4318 端口运行，演示平台不需要直接配置
# 如需绕过 relay 直连阿里云，需设置 x-arms-* 认证头（不推荐）
