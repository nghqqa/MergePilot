  "findings": [
    {
      "description": "SQL injection in search_products: the keyword parameter is interpolated directly into a LIKE query with f-string. An attacker can inject arbitrary SQL by supplying crafted input, e.g. %' OR '1'='1.",
      "category": "injection",
      "severity": "high"
    },
    {
      "description": "SQL injection in get_order: the order_id parameter is interpolated directly into the query with f-string without validation or parameterization. An attacker can manipulate the query, e.g. 1 OR 1=1, to retrieve unauthorized data.",
      "category": "injection",
      "severity": "high"
    }
  ],
  "decision": "HOLD",
  "fix_description": "Replace f-string SQL interpolation with parameterized queries for both functions. In search_products, use: cursor.execute(\"SELECT * FROM products WHERE name LIKE ?\", (f\"%{keyword}%\",)). In get_order, use: cursor.execute(\"SELECT * FROM orders WHERE id = ?\", (order_id,)). This prevents SQL injection by treating user input as data only.",
