  "findings": [
    {
      "description": "SSRF vulnerability in preview_url: the user-supplied user_url is fetched server-side with requests.get, allowing an attacker to probe internal services, cloud metadata endpoints (e.g., 169.254.169.254), or localhost resources. The response body (truncated to 200 chars) is returned to the caller, potentially leaking internal data.",
      "category": "other",
      "severity": "high"
    },
    {
      "description": "Webhook delivery uses requests.get with the event passed as a query parameter. This exposes event data in the URL (logs, history) and violates webhook conventions that typically require POST with an event body. Additionally, using GET can cause side effects via caches or proxies.",
      "category": "logic-bug",
      "severity": "low"
    },
    {
      "description": "deliver_event fails to handle a missing webhook target: if fetch_webhook_target returns None, requests.get(None, ...) raises a TypeError, causing an unhandled exception. This could disrupt the event processing pipeline.",
      "category": "logic-bug",
      "severity": "low"
    },
    {
      "description": "The webhook target URL comes from the database without any validation or allow-listing. If an attacker can influence the workspace's integration hook_url (or workspace_id), this becomes an SSRF vector similar to preview_url. The server would make requests to arbitrary URLs supplied by the attacker.",
      "category": "other",
      "severity": "medium"
    }
  ],
  "decision": "REJECT",
