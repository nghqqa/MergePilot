{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mergepilot.dev/skills/test-runner/schema/input.schema.json",
  "title": "TestRunner Input",
  "description": "Business input for the test-runner Skill (contract_version 1). The caller selects a runner profile and supplies relative test_paths plus its own restricted env_values (strings only). No command/argv/workspace_root/artifact_globs fields; workspace, executor, network policy, image digest and env allowlist are deploy-owned.",
  "type": "object",
  "additionalProperties": false,
  "required": ["runner_key", "test_paths"],
  "properties": {
    "runner_key": { "type": "string", "minLength": 1, "maxLength": 64 },
    "test_paths": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
    "env_values": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": { "type": "string", "maxLength": 4096 }
    },
    "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 300000 },
    "max_output_bytes": { "type": "integer", "minimum": 1, "maximum": 524288 },
    "expected_profiles_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  }
}
