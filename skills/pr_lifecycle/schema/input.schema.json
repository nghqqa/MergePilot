{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mergepilot.dev/skills/pr-lifecycle/schema/input.schema.json",
  "title": "PRLifecycle Input",
  "description": "High-level, policy-gateway-only GitHub lifecycle actions. Trust configuration (role, token, repo, base, run and SHAs) is deploy-owned and never accepted here.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "idempotency_key", "changes", "commit_message", "pr_title", "pr_body"],
      "properties": {
        "action": {"const": "ensure_fix_pr"},
        "idempotency_key": {"$ref": "#/$defs/idempotency_key"},
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/change"}
        },
        "commit_message": {"$ref": "#/$defs/commit_message"},
        "pr_title": {"$ref": "#/$defs/pr_title"},
        "pr_body": {"$ref": "#/$defs/pr_body"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "idempotency_key", "commit_message", "pr_title", "pr_body"],
      "properties": {
        "action": {"const": "ensure_revert_pr"},
        "idempotency_key": {"$ref": "#/$defs/idempotency_key"},
        "commit_message": {"$ref": "#/$defs/commit_message"},
        "pr_title": {"$ref": "#/$defs/pr_title"},
        "pr_body": {"$ref": "#/$defs/pr_body"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "idempotency_key", "pull_number", "approval_ticket", "merge_method", "commit_title"],
      "properties": {
        "action": {"const": "merge_pr"},
        "idempotency_key": {"$ref": "#/$defs/idempotency_key"},
        "pull_number": {"$ref": "#/$defs/pull_number"},
        "approval_ticket": {"$ref": "#/$defs/approval_ticket"},
        "merge_method": {"type": "string", "enum": ["merge", "squash", "rebase"]},
        "commit_title": {"$ref": "#/$defs/pr_title"},
        "commit_message": {"type": "string", "maxLength": 4096}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "idempotency_key", "pull_number", "approval_ticket"],
      "properties": {
        "action": {"const": "close_pr"},
        "idempotency_key": {"$ref": "#/$defs/idempotency_key"},
        "pull_number": {"$ref": "#/$defs/pull_number"},
        "approval_ticket": {"$ref": "#/$defs/approval_ticket"}
      }
    }
  ],
  "$defs": {
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "content": {"type": "string", "maxLength": 262144}
      }
    },
    "commit_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\r\\n]+$"
    },
    "pr_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\r\\n]+$"
    },
    "pr_body": {
      "type": "string",
      "maxLength": 16384
    },
    "pull_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "approval_ticket": {
      "type": "string",
      "pattern": "^tkt-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
