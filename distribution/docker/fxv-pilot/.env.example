# FXV 受控试点环境变量——全部为占位符，不含真实秘密。生成命令见各条注释
FXV_PG_PASSWORD=change-me-openssl-rand-hex-12
FXV_MINIO_USER=change-me
FXV_MINIO_PASSWORD=change-me-openssl-rand-hex-12
FXV_CONSOLE_USER=pilot
FXV_CONSOLE_PASSWORD=change-me-openssl-rand-hex-12
FXV_SESSION_SECRET=change-me-openssl-rand-hex-32
FXV_REPO_ALLOWLIST=acme/app
FXV_S3_BUCKET=fxv-artifacts
FXV_CONSOLE_PORT=48410
# ── C 链（可选；不配置 = /api/cchain/status 如实 BLOCKED，绝不伪造 READY）──
# 模型缓存目录（卷内，需真实模型文件 + manifest.json 内容寻址清单）
FXV_MODEL_CACHE_DIR=/data/model-cache
# RUN_BINDING_AUTH keystore 目录（卷内；*.key.json 由受控通道分发/轮换）
FXV_RUN_BINDING_KEYSTORE=/data/cchain-keystore
# provider 在线 attestation 端点（真实 provider 就绪后填）
FXV_PROVIDER_ATTEST_URL=
FXV_PROVIDER_EXPECTED_KEY_ID=
# enforce=1 时 FXV run 启动被 C 链 READY 门禁拦截（默认 0=off）
FXV_CCHAIN_ENFORCE=0
# ── G-07 多凭证（可选；不配置回落 legacy 单用户）──
FXV_ACCESS_MODEL_JSON=
FXV_USER_CREDENTIALS_JSON=
