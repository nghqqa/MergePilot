# MergePilot Console — Environment Configuration Template
# Copy to .env and fill in all values. NEVER commit the .env file.

# === PostgreSQL ===
PG_DB=mergepilot
PG_USER=mergepilot
# Generate: openssl rand -hex 16
PG_PASSWORD=<generate-a-strong-password>

# === MinIO ===
# Generate: openssl rand -hex 8 (min 8 chars)
MINIO_USER=<generate-a-username>
# Generate: openssl rand -hex 16
MINIO_PASSWORD=<generate-a-strong-password>

# === Console Authentication ===
CONSOLE_USER=<operator-username>
# Generate: openssl rand -hex 12
CONSOLE_PASSWORD=<generate-a-strong-password>
# Generate: openssl rand -hex 24 (session signing key)
SESSION_SECRET=<generate-a-random-secret>

# === Repository Allowlist ===
# Comma-separated list of authorized repositories (server-enforced)
# Only repositories in this list will be visible to the operator
REPO_ALLOWLIST=owner/repo1,owner/repo2

# === Evidence Root ===
# Path to the read-only evidence directory (mounted into container)
EVIDENCE_ROOT=./evidence

# === Console Port ===
CONSOLE_PORT=4730

# === A-Chain (Organization Knowledge Retrieval) ===
# DEFAULT: OFF. Do not set unless explicitly authorized.
# MERGEPILOT_ORG_RAG_A_CHAIN=1
# ORG_RAG_LIVE_URL=http://host.docker.internal:48210

# === SECURITY NOTES ===
# 1. All secrets must be generated fresh for each deployment
# 2. The .env file must never be committed to version control
# 3. PG/MinIO are on internal network only (not externally accessible)
# 4. Console binds to loopback by default (127.0.0.1)
# 5. A-chain (org knowledge RAG) is disabled by default
# 6. C-chain (case_retrieval) is BLOCKED — see docs/RAG-STATUS.md
# 7. embedding/pgvector/model_cache are all disabled
# 8. RUN_BINDING_AUTH is NOT_WIRED
# 9. GitHub writes are disabled — read-only by design
