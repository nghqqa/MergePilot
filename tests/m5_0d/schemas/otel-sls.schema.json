{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mergepilot.dev/m5-0d/schemas/otel-sls.schema.json",
  "title": "OTel/SLS Observability Evidence",
  "type": "object",
  "required": ["schema_version", "source_commit", "provenance", "spans", "sls_schema"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "provenance": {
      "type": "object",
      "required": [
        "collector_kind", "collector_script_sha256", "collector_command_digest",
        "collector_endpoint_digest", "capture_window", "captured_at",
        "raw_capture_sha256", "trace_run_binding"
      ],
      "additionalProperties": false,
      "properties": {
        "collector_kind": {"const": "deploy-owned-otel-sls"},
        "collector_script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "collector_command_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "collector_endpoint_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "capture_window": {
          "type": "object",
          "required": ["started_at", "ended_at"],
          "additionalProperties": false,
          "properties": {
            "started_at": {"type": "string"},
            "ended_at": {"type": "string"}
          }
        },
        "captured_at": {"type": "string"},
        "raw_capture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "trace_run_binding": {
          "type": "object",
          "required": ["expected_run_id", "observed_run_ids"],
          "additionalProperties": false,
          "properties": {
            "expected_run_id": {"type": "string", "pattern": "^m5live-[A-Za-z0-9.-]+$"},
            "observed_run_ids": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"type": "string"}
            }
          }
        }
      }
    },
    "spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["trace_id", "span_id", "name", "status", "run_id", "attributes"],
        "additionalProperties": false,
        "properties": {
          "trace_id": {"type": "string"},
          "span_id": {"type": "string"},
          "name": {"type": "string"},
          "status": {"type": "string"},
          "run_id": {"type": "string"},
          "attributes": {"type": "object"}
        }
      }
    },
    "sls_schema": {
      "type": "object",
      "required": ["name", "version", "sha256", "validated_records"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "validated_records": {"type": "integer", "minimum": 1}
      }
    }
  }
}
