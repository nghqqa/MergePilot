{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mergepilot.dev/m5-0d/schemas/production-live.schema.json",
  "title": "Production Tier-C Live Evidence",
  "type": "object",
  "required": [
    "schema_version", "source_commit", "provenance", "sync_events", "stage_events",
    "agent_processes", "task_run", "skill_jobs", "mcp_calls", "dispatch_rows",
    "watcher_config", "injection_scan", "secret_scan", "residue"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "matrix_server_name": {"type": "string"},
    "provenance": {
      "type": "object",
      "required": [
        "collector_kind", "collector_script_sha256", "collector_command_digest",
        "run_key", "capture_window", "collected_at", "raw_capture_sha256",
        "db_snapshot_sha256", "matrix_sync_sha256", "container_snapshot_sha256",
        "gateway_audit_sha256", "github_mcp_log_sha256", "matrix_event_provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "collector_kind": {"const": "deploy-owned-production-tier-c"},
        "collector_script_sha256": {"$ref": "#/$defs/sha256"},
        "collector_command_digest": {"$ref": "#/$defs/sha256"},
        "run_key": {"type": "string", "pattern": "^m5live-[A-Za-z0-9.-]+$"},
        "capture_window": {
          "type": "object",
          "required": ["started_at", "ended_at"],
          "additionalProperties": false,
          "properties": {
            "started_at": {"type": "string"},
            "ended_at": {"type": "string"}
          }
        },
        "collected_at": {"type": "string"},
        "raw_capture_sha256": {"$ref": "#/$defs/sha256"},
        "db_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "matrix_sync_sha256": {"$ref": "#/$defs/sha256"},
        "container_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "gateway_audit_sha256": {"$ref": "#/$defs/sha256"},
        "github_mcp_log_sha256": {"$ref": "#/$defs/sha256"},
        "matrix_event_provenance": {
          "type": "object",
          "required": ["sync_event_ids", "stage_event_ids"],
          "additionalProperties": false,
          "properties": {
            "sync_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
            "stage_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
          }
        }
      }
    },
    "sync_events": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sync_batch_id", "event_id", "room_id", "sender", "event_type", "body_sha256", "received_at", "consumer_name"],
        "additionalProperties": false,
        "properties": {
          "sync_batch_id": {"$ref": "#/$defs/sha256"},
          "event_id": {"type": "string"}, "room_id": {"type": "string"},
          "sender": {"type": "string"}, "event_type": {"type": "string"},
          "body_sha256": {"$ref": "#/$defs/sha256"},
          "received_at": {"type": "string"}, "consumer_name": {"$ref": "#/$defs/consumer_name"}
        }
      }
    },
    "stage_events": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage_event_id", "matrix_event_id", "room_id", "sender", "event_type", "stage", "status", "parsed_run_id", "processed_by", "error_code"],
        "additionalProperties": false,
        "properties": {
          "stage_event_id": {"type": "string"}, "matrix_event_id": {"type": "string"},
          "room_id": {"type": "string"}, "sender": {"type": "string"},
          "event_type": {"type": "string"}, "stage": {"type": "string"},
          "status": {"type": "string"}, "parsed_run_id": {"type": "string"},
          "processed_by": {"type": "string"}, "error_code": {"type": "string"}
        }
      }
    },
    "agent_processes": {
      "type": "object", "required": ["manager", "reviewer", "fixer", "verifier"],
      "additionalProperties": false,
      "properties": {
        "manager": {"$ref": "#/$defs/agent"}, "reviewer": {"$ref": "#/$defs/agent"},
        "fixer": {"$ref": "#/$defs/agent"}, "verifier": {"$ref": "#/$defs/agent"}
      }
    },
    "task_run": {
      "type": "object",
      "required": ["run_id", "room_id", "status", "current_stage", "verdict", "consumer_name", "revision_binding_id", "base_sha", "head_sha", "review_stage_event_id", "fix_stage_event_id", "verify_stage_event_id"],
      "additionalProperties": false,
      "properties": {
        "run_id": {"type": "string"}, "room_id": {"type": "string"},
        "status": {"type": "string"}, "current_stage": {"type": "string"},
        "verdict": {"type": "string"}, "consumer_name": {"$ref": "#/$defs/consumer_name"},
        "revision_binding_id": {"type": "string"}, "base_sha": {"$ref": "#/$defs/sha1"},
        "head_sha": {"$ref": "#/$defs/sha1"}, "review_stage_event_id": {"type": "string"},
        "fix_stage_event_id": {"type": "string"}, "verify_stage_event_id": {"type": "string"}
      }
    },
    "skill_jobs": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["skill_name", "job_id", "invocation_id", "status", "revision_binding_id", "output_schema_validated"],
        "additionalProperties": false,
        "properties": {
          "skill_name": {"type": "string"}, "job_id": {"type": "string"},
          "invocation_id": {"type": "string"}, "status": {"type": "string"},
          "revision_binding_id": {"type": "string"}, "output_schema_validated": {"type": "boolean"}
        }
      }
    },
    "mcp_calls": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["call_id", "caller_agent", "tool", "decision", "revision_binding_id", "base_sha", "head_sha", "upstream_kind", "audit_dsn_kind"],
        "additionalProperties": false,
        "properties": {
          "call_id": {"type": "string"}, "caller_agent": {"type": "string"},
          "tool": {"type": "string"}, "decision": {"type": "string"},
          "revision_binding_id": {"type": "string"}, "base_sha": {"$ref": "#/$defs/sha1"},
          "head_sha": {"$ref": "#/$defs/sha1"}, "upstream_kind": {"type": "string"},
          "audit_dsn_kind": {"type": "string"}
        }
      }
    },
    "dispatch_rows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dispatch_id", "role", "stage_event_id", "source"],
        "additionalProperties": false,
        "properties": {
          "dispatch_id": {"type": "string"}, "role": {"type": "string"},
          "stage_event_id": {"type": "string"}, "source": {"type": "string"}
        }
      }
    },
    "watcher_config": {
      "type": "object", "required": ["excluded_prefixes"], "additionalProperties": false,
      "properties": {"excluded_prefixes": {"type": "array", "items": {"type": "string"}}}
    },
    "injection_scan": {
      "type": "object", "required": ["scanned_sources", "forbidden_invocations"], "additionalProperties": false,
      "properties": {
        "scanned_sources": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "forbidden_invocations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "secret_scan": {
      "type": "object", "required": ["scanned_targets", "matches"], "additionalProperties": false,
      "properties": {
        "scanned_targets": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "matches": {"type": "array", "items": {"type": "string"}}
      }
    },
    "residue": {
      "type": "object",
      "required": ["containers", "networks", "volumes", "temp_dirs", "open_prs", "branches"],
      "additionalProperties": false,
      "properties": {
        "containers": {"type": "array", "items": {"type": "string"}},
        "networks": {"type": "array", "items": {"type": "string"}},
        "volumes": {"type": "array", "items": {"type": "string"}},
        "temp_dirs": {"type": "array", "items": {"type": "string"}},
        "open_prs": {"type": "array", "items": {"type": "string"}},
        "branches": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "consumer_name": {
      "type": "string", "minLength": 1,
      "not": {"const": "controller"},
      "description": "Candidate controller consumer (controller_offsets PK). Must differ from the production default 'controller' (controller.py:99-100); m5live runs are processed only by the Candidate."
    },
    "agent": {
      "type": "object",
      "required": ["role", "container_id", "image_id", "matrix_user_id", "started_at", "command_digest", "log_digest"],
      "additionalProperties": false,
      "properties": {
        "role": {"type": "string"}, "container_id": {"type": "string"},
        "image_id": {"type": "string"}, "matrix_user_id": {"type": "string"},
        "started_at": {"type": "string"}, "command_digest": {"$ref": "#/$defs/sha256"},
        "log_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
