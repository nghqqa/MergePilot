# MergePilot 自托管环境变量模板（基线 rc.35.6-rc2 预发布）
# 用法：cp .env.example .env && 按注释填写；.env 权限建议 chmod 600。
# 纪律：本文件不包含任何真实 secrets；生成命令见各段注释。

# ── 必填 ────────────────────────────────────────────────────────────────
# 数据库密码（compose 拼接 DSN 用）。生成：openssl rand -hex 16
POSTGRES_PASSWORD=

# 控制台会话签名密钥。生成：openssl rand -base64 32
CONSOLE_SESSION_SECRET=

# GitHub App（自建，权限最小集见 README「多租户与 webhook」）
MU_GITHUB_APP_ID=
# App 私钥 PEM 全文（含 BEGIN/END 行）。权限 0600；绝不入库/日志
MU_GITHUB_APP_PRIVATE_KEY=
# App 的 URL slug：https://github.com/settings/apps/<slug>
MU_GITHUB_APP_SLUG=
# webhook 签名密钥（须与 App 设置页一致）。生成：openssl rand -hex 32
MU_GITHUB_WEBHOOK_SECRET=

# GitHub OAuth App（用户登录用；与 GitHub App 不同——两者都要建）
MU_GITHUB_OAUTH_CLIENT_ID=
MU_GITHUB_OAUTH_CLIENT_SECRET=

# 回调地址：把 <host> 换成你的对外访问主机/域名（务必 https）
MU_GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:48500/api/mu/auth/oauth/github/callback
MU_GITHUB_APP_INSTALL_CALLBACK_URL=http://127.0.0.1:48500/multiuser

# ── Gitee（全部可选；不填则登录页不渲染 Gitee 入口、Gitee 仓库连接不可用）─────
# Gitee OAuth 登录（三项任一缺失即 fail-closed 不渲染入口；scope=user_info）
MU_GITEE_OAUTH_CLIENT_ID=
MU_GITEE_OAUTH_CLIENT_SECRET=
MU_GITEE_OAUTH_CALLBACK_URL=http://127.0.0.1:48500/api/mu/auth/oauth/gitee/callback
# Gitee 连接 PAT（仓库连接/评论发布/可应用性检查/应用与合并的 Gitee 侧凭据）
MU_GITEE_PAT=

# ── LLM（审查管线用；必填）────────────────────────────────────────────
# openai_compatible 端点；key 仅存 env，绝不入库/日志
MU_LLM_PROVIDER=openai_compatible
MU_LLM_BASE_URL=
MU_LLM_MODEL=
MU_LLM_API_KEY=
MU_LLM_ALLOWED_MODELS=

# ── RAG 检索（可选；不填则 RAG=NOT_WIRED 如实降级）────────────────────
# bge-m3 模型文件目录（挂载进 console 的 /app/rag-models；见 README 模型下载）
RAGTRIAL_EMBED_MODEL_ID=bge-m3
RAGTRIAL_EMBED_DIMS=1024
# 清单校验值（模型安装完成后由 /api 输出回填；空=跳过校验但如实标注）
RAGTRIAL_EMBED_EXPECTED_MANIFEST=
RAGTRIAL_ALLOWED_SCOPES=

# ── cchain 信任链（可选；三项不全则 cchain=BLOCKED，fail-closed）───────
# 模型缓存目录（挂载 model-cache 卷；放入 bge-m3 官方清单文件后可 READY）
MERGEPILOT_MODEL_CACHE_DIR=/app/rag-models
# 供应商证明静态端点：填 console 容器内可达的 URL。compose 内 attest 服务填
# http://attest/attestation.json；宿主级静态服务填
# http://host.docker.internal:<端口>/attestation.json（Linux 需 console 加 host-gateway）。
# 端点须返回含 provider/model/attestation 非空字段的 JSON——见 README「provider attestation」节。
MERGEPILOT_PROVIDER_ATTEST_URL=
# 可选（仅 preflight --live 用）：本机 attestation.json 源文件路径，探测时与端点内容比对
# MERGEPILOT_PROVIDER_ATTEST_FILE=
# 运行绑定 keystore（keystore 卷；轮换经 /api/cchain/keystore/rotate）
MERGEPILOT_RUN_BINDING_KEYSTORE=/app/keystore

# ── 可选：AgentTeams 执行器（不填则执行器面 NOT_WIRED）────────────────
MU_EXECUTOR=
MU_AGENTTEAMS_BASE_URL=
MU_AGENTTEAMS_TOKEN=
MU_AGENTTEAMS_RUNTIME=
MU_AGENTTEAMS_MODEL=
MU_AGENTTEAMS_MATRIX_URL=
MU_AGENTTEAMS_MATRIX_USER=
MU_AGENTTEAMS_MATRIX_PASSWORD=

# ── 可选：实际修复测试的预批准命令（唯一命令来源；绝不取自模型输出）─────
# JSON 映射，key 为 "provider:owner/repo"（兼容 "owner/repo"）；未配置=如实"未执行"
# MU_FIX_TEST_CMDS={"github:acme/widget":"npm test","gitee:acme/widget":"cargo test"}
# 仅隔离 E2E 用（生产必须移除，诊断会 WARN）：
# MU_FIX_TEST_ALLOW_DEPS_CMD=1

# ── 可选：事件自动消费循环（默认开启）────────────────────────────────
# 关闭后事件滞留队列需人工 POST /api/mu/jobs/tick；间隔 250ms–600000ms，默认 45000
# MU_JOB_CONSUMER_ENABLED=1
# MU_JOB_CONSUMER_INTERVAL_MS=45000

# ── 端口（默认仅回环）─────────────────────────────────────────────────
CONSOLE_PORT=48500
WEBHOOK_INGRESS_PORT=48590
