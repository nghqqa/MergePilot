+def _cas_managed_task_meta_path(normalized: str) -> bool:
+    """True for shared-storage paths whose task meta.json must only be
+    written through the CAS. Matches .../tasks/<task_id>/meta.json and the
+    enclosing task directory, under the team-scoped shared prefix or the
+    standalone shared/ root. Project meta (shared/projects/...) is NOT
+    matched - it is a separate write surface."""
+    parts = [p for p in normalized.strip("/").split("/") if p]
+    if "tasks" not in parts:
+        return False
+    rest = parts[parts.index("tasks") + 1:]
+    if not 1 <= len(rest) <= 2:
+        return False
+    return len(rest) == 1 or rest[1] == "meta.json"
+
