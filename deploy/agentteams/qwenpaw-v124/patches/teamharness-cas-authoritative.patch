+def _cas_task_keys(task_id: str) -> list[str]:
+    """Object keys for a task meta in priority order. Mirrors the shared
+    prefix derivation used by _filesync, so the conditional write and the
+    mc transport always address the same object. _default_shared_prefix may
+    carry the mc transport head ("alias/bucket" from
+    AGENTTEAMS_STORAGE_PREFIX); the boto3 path addresses the bucket
+    directly, so the head is stripped to get the bare object key (the
+    controller's taskMetaKeys uses the same bare-key convention)."""
+    prefix = _default_shared_prefix().strip("/")
+    bucket = _cas_bucket()
+    for head in (f"{MC_ALIAS}/{bucket}", MC_ALIAS, bucket):
+        if prefix == head:
+            prefix = ""
+            break
+        if prefix.startswith(head + "/"):
+            prefix = prefix[len(head) + 1:]
+            break
+    keys: list[str] = []
+    if prefix and prefix != "shared":
+        keys.append(f"{prefix}/tasks/{task_id}/meta.json")
+    keys.append(f"shared/tasks/{task_id}/meta.json")
+    return keys
+
+
+def _cas_precondition_failed(exc: BaseException) -> bool:
+    code = ""
+    response = getattr(exc, "response", None)
+    if isinstance(response, dict):
+        code = str((response.get("Error") or {}).get("Code") or "")
+    return code in {"PreconditionFailed", "412", "PreconditionFailed "}
+
+
+def _cas_read_task(s3, task_id: str):
+    """Authoritative read of the task meta straight from shared storage.
+    Returns (data, etag, key); (None, None, None) when no copy exists.
+    Transport failures raise - callers must not guess at authority."""
+    from botocore.exceptions import ClientError
+
+    bucket = _cas_bucket()
+    for key in _cas_task_keys(task_id):
+        try:
+            resp = s3.get_object(Bucket=bucket, Key=key)
+        except ClientError as exc:
+            code = str((getattr(exc, "response", {}) or {}).get("Error", {}).get("Code") or "")
+            if code in {"NoSuchKey", "404"}:
+                continue
+            raise
+        etag = str(resp.get("ETag") or "").strip().strip('"')
+        data = json.loads(resp["Body"].read().decode("utf-8"))
+        return data, etag, key
+    return None, None, None
+
+
+def _cas_task_meta_bytes(task: dict[str, Any]) -> bytes:
+    # Byte-identical to _write_json so the local cache and the
+    # authoritative object never diverge in formatting.
+    return (json.dumps(task, ensure_ascii=False, indent=2, sort_keys=True) + "\n").encode("utf-8")
+
+
+def _cas_merge_remote_history(task: dict[str, Any], remote: dict[str, Any]) -> None:
+    """Union concurrent history entries so a CAS retry never drops another
+    writer's audit trail. Entries are identified by (seq, ts, action, from,
+    to); remote-only entries are appended in seq order."""
+    task_history = task.get("history")
+    if not isinstance(task_history, list):
+        task_history = []
+        task["history"] = task_history
+    remote_history = remote.get("history")
+    if not isinstance(remote_history, list):
+        return
+
+    def identity(entry: dict[str, Any]) -> tuple:
+        return (
+            entry.get("seq"),
+            entry.get("ts"),
+            entry.get("action"),
+            entry.get("from"),
+            entry.get("to"),
+        )
+
+    known = {identity(e) for e in task_history if isinstance(e, dict)}
+    missing = [e for e in remote_history if isinstance(e, dict) and identity(e) not in known]
+    if missing:
+        task_history.extend(missing)
+        task_history.sort(key=lambda e: e.get("seq") or 0)
+    try:
+        task["history_seq"] = max(
+            int(task.get("history_seq") or 0),
+            max((int(e.get("seq") or 0) for e in task_history if isinstance(e, dict)), default=0),
+        )
+    except (TypeError, ValueError):
+        pass
+
