+def _cas_s3_client():
+    """boto3 S3 client bound to this runtime's own scoped FS credentials
+    (AGENTTEAMS_FS_*: the per-worker MinIO user provisioned by the
+    controller, never the root credential). Returns None when the storage
+    environment is not configured at all."""
+    import boto3
+    from botocore.config import Config
+
+    endpoint = os.environ.get("AGENTTEAMS_FS_ENDPOINT", "").strip().rstrip("/")
+    access_key = os.environ.get("AGENTTEAMS_FS_ACCESS_KEY", "").strip()
+    secret_key = os.environ.get("AGENTTEAMS_FS_SECRET_KEY", "").strip()
+    if not endpoint or not access_key or not secret_key:
+        return None
+    return boto3.client(
+        "s3",
+        endpoint_url=endpoint,
+        aws_access_key_id=access_key,
+        aws_secret_access_key=secret_key,
+        config=Config(signature_version="s3v4", s3={"addressing_style": "path"}),
+    )
+
+
+def _cas_bucket() -> str:
+    return (
+        os.environ.get("AGENTTEAMS_FS_BUCKET", "").strip()
+        or "agentteams-storage"
+    )
+
