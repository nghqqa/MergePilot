+// writeTaskMetaCancelledCAS persists the cancelled task meta with a
+// compare-and-swap. The unconditional PutObject it replaces could clobber a
+// concurrent worker transition (submit/ack) that landed after this request
+// read the meta: a late submission would then overwrite the cancelled state
+// and resurrect the task. The first attempt writes the exact bytes that were
+// validated against the read; on ETag conflict the meta is re-read and the
+// cancellation re-applied against the fresh state (submission fence and
+// terminal guard re-checked). Three conflicts surface as 409 for an
+// explicit client retry.
+func (h *ProjectHandler) writeTaskMetaCancelledCAS(
+	ctx context.Context,
+	w http.ResponseWriter,
+	taskID, team, etag, key string,
+	taskJSON []byte,
+	requestedSubmissionID string,
+	applyCancelledMeta func(data map[string]any, fromStatus string) ([]byte, error),
+) bool {
+	if etag == "" || key == "" {
+		// No authoritative copy existed at read time; CancelTask rejects a
+		// missing task meta earlier (404), so this is a concurrent
+		// disappearance — never create unconditionally from a cancel.
+		writeError(w, http.StatusConflict, "task meta is no longer available; retry")
+		return false
+	}
+	for attempt := 0; attempt < 3; attempt++ {
+		err := h.oss.PutObjectIfMatch(ctx, key, taskJSON, etag)
+		if err == nil {
+			return true
+		}
+		if !errors.Is(err, oss.ErrPreconditionFailed) {
+			writeError(w, http.StatusInternalServerError, "write task meta: "+err.Error())
+			return false
+		}
+		fresh, freshEtag, freshKey, rerr := readTaskMetaFirstWithETag(h, ctx, taskID, team)
+		if rerr != nil {
+			writeError(w, http.StatusInternalServerError, "re-read task meta: "+rerr.Error())
+			return false
+		}
+		if fresh == nil {
+			writeError(w, http.StatusConflict, "task meta disappeared concurrently; retry")
+			return false
+		}
+		freshStatus, _ := fresh["status"].(string)
+		freshStatus = strings.TrimSpace(freshStatus)
+		if isTerminalTaskStatus(freshStatus) && freshStatus != "cancelled" {
+			writeError(w, http.StatusConflict, "cannot cancel terminal task: "+freshStatus)
+			return false
+		}
+		freshSubmissionID, _ := fresh["submission_id"].(string)
+		freshSubmissionID = strings.TrimSpace(freshSubmissionID)
+		if freshSubmissionID != "" && requestedSubmissionID != freshSubmissionID {
+			writeError(w, http.StatusConflict, "submissionId does not match the current task submission")
+			return false
+		}
+		taskJSON, err = applyCancelledMeta(fresh, freshStatus)
+		if err != nil {
+			writeError(w, http.StatusInternalServerError, "marshal task meta: "+err.Error())
+			return false
+		}
+		etag, key = freshEtag, freshKey
 	}
-	return nil, nil
