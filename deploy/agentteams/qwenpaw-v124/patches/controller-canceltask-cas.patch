+// PutObjectIfMatch mirrors PutObject's injection: since the CAS change the
+// cancel path persists the task meta through the conditional write, and a
+// task-meta write failure must surface identically.
+func (f *failTaskPutOSS) PutObjectIfMatch(ctx context.Context, key string, data []byte, matchETag string) error {
+	if f.failures > 0 && strings.HasPrefix(key, f.failPrefix) {
+		f.failures--
+		return errors.New("injected task-meta write failure")
+	}
+	return f.StorageClient.PutObjectIfMatch(ctx, key, data, matchETag)
+}
+
+// taskRaceOSS wraps a Memory store and, on the Nth GetObject of the task
+// meta key, writes a concurrent worker version of the task meta — simulating
+// a worker submit_task landing between the cancel's read and its conditional
+// write. PutObjectIfMatch carries real ETag semantics, so the controller's
+// first write fails with ErrPreconditionFailed exactly like MinIO.
+type taskRaceOSS struct {
+	mcLike      *mcLikeOSS
+	taskKey     string
+	injectOnGet int
+	getCalls    int
+	injectBody  string
+}
+
+func (c *taskRaceOSS) ListObjects(ctx context.Context, prefix string) ([]string, error) {
+	return c.mcLike.ListObjects(ctx, prefix)
+}
+
+func (c *taskRaceOSS) ListObjectsDetailed(ctx context.Context, prefix string) ([]oss.ObjectInfo, error) {
+	return c.mcLike.ListObjectsDetailed(ctx, prefix)
+}
+
+func (c *taskRaceOSS) GetObject(ctx context.Context, key string) ([]byte, error) {
+	data, err := c.mcLike.GetObject(ctx, key)
+	if err == nil && key == c.taskKey {
+		c.getCalls++
+		if c.getCalls == c.injectOnGet && c.injectBody != "" {
+			_ = c.mcLike.PutObject(ctx, key, []byte(c.injectBody))
+		}
+	}
+	return data, err
+}
+
+func (c *taskRaceOSS) PutObject(ctx context.Context, key string, data []byte) error {
+	return c.mcLike.PutObject(ctx, key, data)
+}
+
+func (c *taskRaceOSS) PutObjectIfMatch(ctx context.Context, key string, data []byte, matchETag string) error {
+	cur, err := c.mcLike.StatMeta(ctx, key)
+	if err != nil {
+		return err
+	}
+	if cur.ETag != matchETag {
+		return oss.ErrPreconditionFailed
+	}
+	return c.mcLike.PutObject(ctx, key, data)
+}
+
+func (c *taskRaceOSS) Stat(ctx context.Context, key string) error {
+	return c.mcLike.Stat(ctx, key)
+}
+
+func (c *taskRaceOSS) StatMeta(ctx context.Context, key string) (oss.ObjectMeta, error) {
+	return c.mcLike.StatMeta(ctx, key)
+}
+
+func (c *taskRaceOSS) PutFile(ctx context.Context, localPath, key string) error {
+	return c.mcLike.PutFile(ctx, localPath, key)
+}
+
+func (c *taskRaceOSS) DeleteObject(ctx context.Context, key string) error {
+	return c.mcLike.DeleteObject(ctx, key)
+}
+
+func (c *taskRaceOSS) Mirror(ctx context.Context, src, dst string, opts oss.MirrorOptions) error {
+	return c.mcLike.Mirror(ctx, src, dst, opts)
+}
+
+func (c *taskRaceOSS) DeletePrefix(ctx context.Context, prefix string) error {
+	return c.mcLike.DeletePrefix(ctx, prefix)
+}
+
+// TestCancelTask_ConcurrentSubmitKeepsFenceAndFreshState: a worker
+// submission lands between the cancel's read and write. The conditional
+// write fails; the retry re-reads the fresh (submitted, non-terminal) state
+// and the submission fence applies exactly as it would on a fresh request —
+// the cancel without the raced submissionId is rejected 409 and the fresh
+// submitted state is NOT clobbered.
+func TestCancelTask_ConcurrentSubmitKeepsFenceAndFreshState(t *testing.T) {
+	store := ossfake.NewMemory()
+	putProject(store, "shared/projects/p1/meta.json", map[string]any{
+		"project_id": "p1", "title": "P1", "status": "active", "plan_type": "dag",
+		"tasks": []map[string]any{{"task_id": "t1", "title": "T1", "status": "in_progress", "depends_on": []string{}}},
+	})
+	putTask(store, "shared/tasks/t1/meta.json", map[string]any{
+		"task_id": "t1", "project_id": "p1", "status": "in_progress",
+	})
+	racer := &taskRaceOSS{mcLike: &mcLikeOSS{Memory: store}, taskKey: "shared/tasks/t1/meta.json", injectOnGet: 1,
+		injectBody: `{"task_id":"t1","project_id":"p1","status":"submitted","submission_id":"sub-race","history":[{"ts":"t","from":"in_progress","to":"submitted","action":"submit_task","actor":"worker:default","seq":1}]}`}
+	h := newProjectTestHandlerWithOSS(t, racer)
+
+	req := httptest.NewRequest(http.MethodPost, "/api/v1/projects/p1/tasks/t1/cancel",
+		strings.NewReader(`{"reason":"obsolete"}`))
+	req.SetPathValue("id", "p1")
+	req.SetPathValue("taskId", "t1")
+	req = withCaller(req, &authpkg.CallerIdentity{Role: authpkg.RoleAdmin, Username: "admin"})
+	rec := httptest.NewRecorder()
+	h.CancelTask(rec, req)
+	if rec.Code != http.StatusConflict {
+		t.Fatalf("cancel status=%d body=%s, want 409 (submission fence applies to the raced state)", rec.Code, rec.Body.String())
+	}
+	if body := rec.Body.String(); !strings.Contains(body, "submissionId") {
+		t.Fatalf("body=%s, want submissionId fence error", body)
+	}
+	taskData, _ := store.GetObject(context.Background(), "shared/tasks/t1/meta.json")
+	var taskMeta map[string]any
+	_ = json.Unmarshal(taskData, &taskMeta)
+	if taskMeta["status"] != "submitted" {
+		t.Fatalf("authoritative task status=%v, want submitted (cancel must not clobber the raced state)", taskMeta["status"])
+	}
+}
