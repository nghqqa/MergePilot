+def _pull_fresh_task(arguments: dict[str, Any], task_id: str) -> dict[str, Any]:
+    """Re-read task meta after forcing a pull from shared storage.
+
+    Fixes the read-your-writes race between leader cancel and worker submit:
+    the leader writes cancelled to its local mirror, syncs to MinIO, then the
+    worker's mirror pulls — but the gap between leader-write and worker-pull
+    lets submit_task read a stale in_progress status and overwrite the cancel.
+
+    This helper forces a MinIO pull of meta.json before the caller reads the
+    local copy, closing the window for submit/ack transitions. It does NOT
+    gate non-mutating reads (check_task etc.).
+    """
+    sync_args = dict(arguments)
+    sync_args.update({"action": "pull", "path": f"shared/tasks/{task_id}/meta.json"})
+    try:
+        _filesync(sync_args)
+    except Exception:
+        pass  # pull failure is non-fatal; caller sees whatever the local copy has
+    return _load_task(arguments, task_id)
+
+
 def _first_text(*values: Any) -> str:
