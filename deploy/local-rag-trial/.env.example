# LOCAL_RAG_TRIAL 本地一次性凭据模板 —— 全部为试验占位值，非真实凭据。
# 复制为 .env 后可原样使用（本栈仅绑定 127.0.0.1，且与所有其他栈隔离）。
# .env 已被 .gitignore 排除，绝不提交。
RAGTRIAL_PG_PASSWORD=ragtrial-local-only-pg
RAGTRIAL_MINIO_USER=ragtrial-local
RAGTRIAL_MINIO_PASSWORD=ragtrial-local-only-minio
RAGTRIAL_CONSOLE_USER=ragtrial-operator
RAGTRIAL_CONSOLE_PASSWORD=ragtrial-local-only-console
RAGTRIAL_SESSION_SECRET=ragtrial-local-only-session-secret-0123456789ab
RAGTRIAL_CONSOLE_PORT=48450
RAGTRIAL_PG_PORT=15436
RAGTRIAL_MINIO_PORT=9113
# RAG 查询 scope 门（fail-closed）：不设 → compose 默认仅放行试验 scope
#   nghqqa/mergepilot@feat/local-rag-trial（与 e2e 常量一致）；
# 覆盖格式：repo@branch（逗号分隔多个，如 my/repo@main,my/repo@dev）；
# 显式置空（RAGTRIAL_ALLOWED_SCOPES=）→ 全拒绝（查询 403 scope_not_configured）。
#RAGTRIAL_ALLOWED_SCOPES=nghqqa/mergepilot@feat/local-rag-trial
