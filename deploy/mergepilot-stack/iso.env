# iso.env — 隔离预览专用环境（随仓提交；全部为非生产测试值，零真实凭据）。
# 生产 OAuth/GitHub App/Matrix/LLM 凭据一律不在此文件——隔离环境不接真实远端。
MU_MODE=multiuser
CONSOLE_PORT=4730
CONSOLE_HOST=0.0.0.0
CONSOLE_SESSION_SECRET=iso-preview-session-secret-not-production
# DSN 无口令：iso PG 为 trust 认证（见 docker-compose.iso.yml），无需口令成分
CONSOLE_PG_DSN=postgres://postgres@pg:5432/mu
MU_ALLOW_FIXTURE_LOGIN=1
CONSOLE_PILOT_USER=dev-pilot
CONSOLE_PILOT_PASSWORD=iso-preview-pw
MU_REVIEW_ARCH=evidence_only
