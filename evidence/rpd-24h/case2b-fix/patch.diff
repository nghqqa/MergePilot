@@ -0,0 +1,123 @@
+"""SECURITY DEMO — containment boundary tests (CASE2-B fix verification).
+
+Covers: ../ traversal, absolute paths, separator/encoding variants,
+symlink escape and legitimate file reads, against the remediated
+``demo_download``. Throwaway temp files only.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import os
+from pathlib import Path
+
+import pytest
+
+_MODULE_PATH = (
+    Path(__file__).resolve().parents[2]
+    / "src"
+    / "interfaces"
+    / "api"
+    / "v1"
+    / "demo_high_risk.py"
+)
+
+
+_MODULE_CACHE = None
+
+
+def _load_demo_module():
+    global _MODULE_CACHE
+    if _MODULE_CACHE is None:
+        spec = importlib.util.spec_from_file_location("demo_high_risk", _MODULE_PATH)
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)  # type: ignore[union-attr]
+        _MODULE_CACHE = module
+    return _MODULE_CACHE
+
+
+def _client():
+    from fastapi import FastAPI
+    from fastapi.testclient import TestClient
+
+    demo = _load_demo_module()
+    app = FastAPI()
+    app.include_router(demo.router, prefix="/demo-security")
+    return TestClient(app), demo
+
+
+@pytest.fixture
+def env(tmp_path, monkeypatch):
+    demo = _load_demo_module()
+    base = tmp_path / "base"
+    base.mkdir()
+    (base / "inside.txt").write_text("LEGIT-INSIDE", encoding="utf-8")
+    (base / "sub").mkdir()
+    (base / "sub" / "subfile.txt").write_text("SUB-OK", encoding="utf-8")
+    outside = tmp_path / "outside"
+    outside.mkdir()
+    (outside / "outside-secret.txt").write_text("TOP-SECRET", encoding="utf-8")
+    (tmp_path / "hostname").write_text("HOSTNAME-LEAK", encoding="utf-8")
+    monkeypatch.setattr(demo, "DEMO_FILES_DIR", str(base))
+    yield {"base": base, "outside": outside}
+    return {"base": base, "outside": outside}
+
+
+ESCAPES = [
+    "../outside-secret.txt",
+    "../../outside-secret.txt",
+    "../../../etc/hostname",
+    "/etc/hostname",
+    "..\\..\\outside-secret.txt",
+    "..%2Foutside-secret.txt",
+    "sub/../../outside-secret.txt",
+]
+
+
+class TestEscapesRejected:
+    @pytest.mark.parametrize("name", ESCAPES)
+    def test_escape_rejected(self, env, name):
+        client, _ = _client()
+        r = client.get("/demo-security/demo/download", params={"name": name})
+        assert r.status_code in (400, 404), (name, r.status_code, r.text[:80])
+        assert "TOP-SECRET" not in r.text
+        assert "HOSTNAME-LEAK" not in r.text
+
+    def test_symlink_escape_rejected(self, env):
+        """symlink inside base -> outside file must not be served."""
+        if os.name == "nt":
+            pytest.skip("symlink creation needs privileges on this host")
+        link = env["base"] / "sneaky"
+        os.symlink(env["outside"], link)
+        client, _ = _client()
+        r = client.get("/demo-security/demo/download",
+                       params={"name": "sneaky/outside-secret.txt"})
+        assert r.status_code in (400, 404)
+        assert "TOP-SECRET" not in r.text
+
+    def test_empty_name_is_404_not_base_listing(self, env):
+        client, _ = _client()
+        r = client.get("/demo-security/demo/download", params={"name": ""})
+        assert r.status_code == 404
+
+
+class TestLegitimateReads:
+    def test_inside_file_served(self, env):
+        client, _ = _client()
+        r = client.get("/demo-security/demo/download",
+                       params={"name": "inside.txt"})
+        assert r.status_code == 200
+        assert "LEGIT-INSIDE" in r.text
+
+    def test_subdir_file_served(self, env):
+        client, _ = _client()
+        r = client.get("/demo-security/demo/download",
+                       params={"name": "sub/subfile.txt"})
+        assert r.status_code == 200
+        assert "SUB-OK" in r.text
+
+    def test_missing_inside_file_is_404(self, env):
+        client, _ = _client()
+        r = client.get("/demo-security/demo/download",
+                       params={"name": "nope.txt"})
+        assert r.status_code == 404
