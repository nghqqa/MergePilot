# agentteams/copaw-worker:223ddc2-build2
# Derived from build1 (223ddc2 faithful build) with the Phase 14.2H
# WD-COPAW-HIGH-RISK-FIX-AUDIT patches:
#   Fix A: project-scoped task storage (task.py, taskflow.py, projectflow.py)
#   Fix B: sync-token replay window + seen-event ledger + robust DM
#          classification (matrix_channel.py)
FROM agentteams/copaw-worker:223ddc2-build1

COPY copaw_worker/task.py /opt/venv/standard/lib/python3.11/site-packages/copaw_worker/task.py
COPY copaw_worker/matrix_channel.py /opt/venv/standard/lib/python3.11/site-packages/copaw_worker/matrix_channel.py
COPY copaw_worker/hooks/tools/taskflow.py /opt/venv/standard/lib/python3.11/site-packages/copaw_worker/hooks/tools/taskflow.py
COPY copaw_worker/hooks/tools/projectflow.py /opt/venv/standard/lib/python3.11/site-packages/copaw_worker/hooks/tools/projectflow.py

COPY copaw_worker/task.py /opt/venv/lite/lib/python3.11/site-packages/copaw_worker/task.py
COPY copaw_worker/matrix_channel.py /opt/venv/lite/lib/python3.11/site-packages/copaw_worker/matrix_channel.py
COPY copaw_worker/hooks/tools/taskflow.py /opt/venv/lite/lib/python3.11/site-packages/copaw_worker/hooks/tools/taskflow.py
COPY copaw_worker/hooks/tools/projectflow.py /opt/venv/lite/lib/python3.11/site-packages/copaw_worker/hooks/tools/projectflow.py
